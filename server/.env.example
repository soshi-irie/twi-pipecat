# Sunflower v2 ASR: aka = Akan/Twi, eng = English. No automatic detection.
STT_LANGUAGE=aka
# mlx uses the Apple GPU; faster-whisper uses CPU INT8; simba uses the remote service.
STT_ENGINE=mlx
# Optional: defaults to ~/.cache/twi-pipecat/sunflower-v2-mlx
# STT_MLX_MODEL_PATH=
# Requires access to Sunbird/faster-whisper-51-african-languages on Hugging Face.
# Optional here if you have already logged in with `uv run hf auth login`.
HF_TOKEN=

# LLM provider: openai or gemini. Restart the server after changing this.
LLM_PROVIDER=gemini

# Gemini LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low

# OpenAI LLM (needed only when LLM_PROVIDER=openai)
OPENAPI_KEY=
OPENAI_MODEL=gpt-4.1

# Streaming speech using the same Gemini key; Notevibes remains selectable.
TTS_PROVIDER=gemini
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Callirrhoe

# Notevibes TTS (only needed with TTS_PROVIDER=notevibes)
NOTEVIBES_API_KEY=
# Select an actual voice ID from GET https://notevibes.com/api/tts/voices
NOTEVIBES_VOICE_ID=

# Optional existing remote STT backend, used only with STT_ENGINE=simba
SIMBA_STT_URL=

# Optional Daily rooms and phone calls
DAILY_API_KEY=
